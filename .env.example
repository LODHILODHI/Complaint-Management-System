# MySQL connection for this Complaint Management System
# Create the database first: CREATE DATABASE complaint_management;
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/complaint_management"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Default admin seeded by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="System Admin"

# Public base URL used when building attachment URLs (optional)
APP_URL="http://localhost:3000"

# Local upload directory (relative to project root)
UPLOAD_DIR="uploads"
