generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  DEPARTMENT_HEAD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  password             String
  phone                String?
  address              String?
  cnic                 String?
  city                 String?
  district             String?
  province             String?
  gender               String?
  dateOfBirth          DateTime?
  alternatePhone       String?
  occupation           String?
  role                 Role           @default(USER)
  approvalStatus       ApprovalStatus @default(PENDING)
  homeDepartmentId     String?
  otherDepartmentNote  String?
  profileCompleted     Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  homeDepartment     Department?  @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[] @relation("HeadDepartments")
  complaintsFiled    Complaint[]  @relation("ComplaintFiler")
  complaintsAssigned Complaint[]  @relation("AssignedDeptHead")
  comments           ComplaintComment[]

  @@index([role])
  @@index([approvalStatus])
  @@index([homeDepartmentId])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members    User[]      @relation("UserHomeDepartment")
  heads      User[]      @relation("HeadDepartments")
  complaints Complaint[]
}

model Complaint {
  id                 String          @id @default(cuid())
  userId             String
  departmentId       String
  title              String
  description        String          @db.Text
  status             ComplaintStatus @default(OPEN)
  assignedDeptHeadId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user             User                  @relation("ComplaintFiler", fields: [userId], references: [id], onDelete: Cascade)
  department       Department            @relation(fields: [departmentId], references: [id])
  assignedDeptHead User?                 @relation("AssignedDeptHead", fields: [assignedDeptHeadId], references: [id], onDelete: SetNull)
  attachments      ComplaintAttachment[]
  comments         ComplaintComment[]

  @@index([userId])
  @@index([departmentId])
  @@index([assignedDeptHeadId])
  @@index([status])
}

model ComplaintAttachment {
  id          String   @id @default(cuid())
  complaintId String
  fileUrl     String
  fileType    String
  uploadedAt  DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintComment {
  id                String   @id @default(cuid())
  complaintId       String
  commentedBy       String
  comment           String   @db.Text
  isFinalResolution Boolean  @default(false)
  createdAt         DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [commentedBy], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([commentedBy])
}
